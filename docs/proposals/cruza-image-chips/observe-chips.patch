+def chip_jpeg(frame, bbox, margin=0.5):
+    """Crop the box (normalised x, y, w, h) plus a margin from an RGB/RGBA
+    frame and return a small JPEG, or None. Box coordinates are in the
+    network's input space; the generous margin covers the small offset from
+    the full frame's scaling."""
+    from PIL import Image  # pillow is a picamera2 dependency
+    h, w = frame.shape[:2]
+    x, y, bw, bh = bbox
+    cx, cy = x + bw / 2, y + bh / 2
+    half_w = max(bw * (1 + margin), 0.08) / 2
+    half_h = max(bh * (1 + margin), 0.08) / 2
+    box = (int(clamp01(cx - half_w) * w), int(clamp01(cy - half_h) * h),
+           int(clamp01(cx + half_w) * w), int(clamp01(cy + half_h) * h))
+    if box[2] - box[0] < 4 or box[3] - box[1] < 4:
+        return None
+    image = Image.fromarray(frame[..., :3]).crop(box)
+    image.thumbnail(CHIP_SIZE)
+    out = io.BytesIO()
+    image.save(out, "JPEG", quality=CHIP_QUALITY)
+    return out.getvalue()
 
 
